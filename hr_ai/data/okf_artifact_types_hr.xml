<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Artefakttyper för HR-bryggan (okf-mixin D12).

             `bridge_module` pekar på hr_ai, så taxonomin kan spåras till
             EN brygga. Namnen är unika i ai.artifact.type (UNIQUE(name)) —
             därför hr_job/hr_employee och inte job/employee. -->
        <record id="artifact_type_hr_job" model="ai.artifact.type">
            <field name="name">hr_job</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">hr_ai</field>
            <field name="model_id" ref="hr.model_hr_job"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
        <record id="artifact_type_hr_employee" model="ai.artifact.type">
            <field name="name">hr_employee</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">hr_ai</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
    </data>
</odoo>
