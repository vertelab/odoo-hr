<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Weekly, because a menu is weekly. A daily check would spend 44
             requests a day to learn the same thing.

             active=False: the check calls every restaurant's website, so a
             customer turns it on deliberately.

             A dead URL is recorded per row and never stops the run; see
             check_menus(). -->
        <record id="ir_cron_lunch_check_menus" model="ir.cron">
            <field name="name">Lunch: check menu links</field>
            <field name="model_id" ref="model_lunch_choice"/>
            <field name="state">code</field>
            <field name="code">model.check_menus()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
