<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The office position is the origin of every lunch distance. It lives in
         ir.config_parameter, not on res.company, because only this module
         needs it. -->
    <record id="res_config_settings_view_form_lunch" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.lunch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Lunch" name="hr_lunch" logo="fa-cutlery">
                    <block title="Office position" name="lunch_company_position">
                        <setting id="lunch_company_position_setting"
                                 string="Coordinates"
                                 help="Origin for the distance to each restaurant. Without it every distance is 0.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="lunch_company_lat" class="col-lg-3 o_light_label"/>
                                    <field name="lunch_company_lat"/>
                                </div>
                                <div class="row">
                                    <label for="lunch_company_lon" class="col-lg-3 o_light_label"/>
                                    <field name="lunch_company_lon"/>
                                </div>
                                <div invisible="lunch_company_position_set">
                                    <div class="text-warning">
                                        No position set — every restaurant will show a distance of 0.
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button name="action_geocode_company"
                                            type="object"
                                            string="Fetch from company address"
                                            class="btn-link"
                                            icon="fa-map-marker"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
