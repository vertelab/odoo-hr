<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- A vote may only be deleted by the person who cast it, or by an
             administrator. Without this, group_user can delete anyone's vote
             (the access row grants perm_unlink). -->
        <record id="rule_lunch_choice_line_own" model="ir.rule">
            <field name="name">Lunch vote: own or administrator</field>
            <field name="model_id" ref="model_lunch_choice_line"/>
            <field name="domain_force">[('vote_user', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
