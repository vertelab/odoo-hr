<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_key" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.key</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_workstyle.view_hr_job_form_workstyle"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workstyle_line_ids']/list/field[@name='rationale']" position="before">
                <field name="rationale_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
