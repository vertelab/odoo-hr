<?xml version="1.0" encoding="utf-8"?>
<!--
    Demo: beteendeprofiler på befattningar och anställda.

    Laddas bara när Odoo installeras MED demo (hr:s egen demodata måste
    finnas — vi refererar hr.job_* och hr.employee_*).

    Två lager:
      1. Kravprofiler (hr.job.workstyle.line) — rollens förväntade
         intervall per stil, med motiv. Intervallet är en ZON, inte ett
         idealvärde: både under och över är information.
      2. Mätningar (hr.workstyle.assessment) — personernas profiler.
         De flesta ligger inom rollens zon (mätningen "passar"), men
         några avviker medvetet på EN stil. En demo där alla matchar
         100 % vore missvisande: modulen handlar om avvikelser, inte
         om att sätta betyg.

    Skalan är 1-10 (se hr_workstyle.style).

    Personreferensen är ett Reference-fält: 'hr.employee,<id>'. I demo
    löses id:t med ref(), t.ex. eval="'hr.employee,%s' % ref('hr.employee_admin')".
-->
<odoo>
    <data>

        <!-- ── Kompetenskrav per befattning ─────────────────────────
             Så att Skill Match-gaugen blir meningsfull i demot: utan
             krav på tjänsten är nämnaren noll och gaugen står på 0.
             Kompetenser = vad någon KAN (hr_skills); beteende = HUR
             någon agerar (denna modul). De två hålls åtskilda men
             visas sida vid sida. -->
        <record id="hr.job_ceo" model="hr.job">
            <field name="skill_ids" eval="[Command.set([
                ref('hr_skills.hr_skill_leadership'),
                ref('hr_skills.hr_skill_decision_making'),
                ref('hr_skills.hr_skill_communication'),
                ref('hr_skills.hr_skill_organizational'),
            ])]"/>
        </record>
        <record id="hr.job_cto" model="hr.job">
            <field name="skill_ids" eval="[Command.set([
                ref('hr_skills.hr_skill_python'),
                ref('hr_skills.hr_skill_js'),
                ref('hr_skills.hr_skill_critical_thinking'),
                ref('hr_skills.hr_skill_communication'),
            ])]"/>
        </record>
        <record id="hr.job_consultant" model="hr.job">
            <field name="skill_ids" eval="[Command.set([
                ref('hr_skills.hr_skill_communication'),
                ref('hr_skills.hr_skill_organizational'),
                ref('hr_skills.hr_skill_time_management'),
                ref('hr_skills.hr_skill_adaptability'),
            ])]"/>
        </record>
        <record id="hr.job_developer" model="hr.job">
            <field name="skill_ids" eval="[Command.set([
                ref('hr_skills.hr_skill_python'),
                ref('hr_skills.hr_skill_js'),
                ref('hr_skills.hr_skill_sql'),
                ref('hr_skills.hr_skill_problem_solving'),
            ])]"/>
        </record>
        <record id="hr.job_hrm" model="hr.job">
            <field name="skill_ids" eval="[Command.set([
                ref('hr_skills.hr_skill_communication'),
                ref('hr_skills.hr_skill_conflict_management'),
                ref('hr_skills.hr_skill_organizational'),
                ref('hr_skills.hr_skill_leadership'),
            ])]"/>
        </record>
        <record id="hr.job_marketing" model="hr.job">
            <field name="skill_ids" eval="[Command.set([
                ref('hr_skills.hr_skill_communication'),
                ref('hr_skills.hr_skill_digital_ad'),
                ref('hr_skills.hr_skill_email'),
                ref('hr_skills.hr_skill_creativity'),
            ])]"/>
        </record>
        <record id="hr.job_trainee" model="hr.job">
            <field name="skill_ids" eval="[Command.set([
                ref('hr_skills.hr_skill_communication'),
                ref('hr_skills.hr_skill_teamwork'),
