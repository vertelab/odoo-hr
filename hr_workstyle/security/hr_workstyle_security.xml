<?xml version="1.0" encoding="utf-8"?>
<!--
    Record rules för beteendemätningar.

    Mätningen är personrelaterad data. Access-reglerna (ir.model.access.csv)
    ger HR-användare och HR-chefer rättigheter; reglerna här begränsar VILKA
    poster de ser.

    Applicant-mätningar kräver rekryteringsbehörighet — en HR-användare utan
    rekryteringsroll ska inte kunna läsa kandidaters beteendeprofiler.
-->
<odoo>
    <data noupdate="0">

        <!-- HR-chefer ser allt. -->
        <record id="rule_workstyle_assessment_manager" model="ir.rule">
            <field name="name">Behavioural measurement: HR manager sees all</field>
            <field name="model_id" ref="model_hr_workstyle_assessment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- HR-användare ser anställdas mätningar, men INTE kandidaters. -->
        <record id="rule_workstyle_assessment_hr_user" model="ir.rule">
            <field name="name">Behavioural measurement: HR user sees employees only</field>
            <field name="model_id" ref="model_hr_workstyle_assessment"/>
            <field name="domain_force">[('res_model', '=', 'hr.employee')]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <!-- Rekryterare ser kandidatmätningar. -->
        <record id="rule_workstyle_assessment_recruiter" model="ir.rule">
            <field name="name">Behavioural measurement: recruiter sees applicants</field>
            <field name="model_id" ref="model_hr_workstyle_assessment"/>
            <field name="domain_force">[('res_model', '=', 'hr.applicant')]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        </record>

    </data>
</odoo>
