<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_about_us_calender_ce" inherit_id="hr_website_about_us.aboutus">
<!--        <xpath expr="//div[@id='contact_employee']" position="inside">-->
        <xpath expr="//t[@t-call='website.layout']/section[hasclass('team-section-new')]//div[@t-if='len(employee_contact)']/div[@t-foreach='employee_contact']/div[1]/div[1]" position="inside">
            <a t-if="employee.booking_type_id.website_url" t-attf-href="{{employee.get_website_url_employee()}}" t-attf-title="Book a meeting with {{employee.name}}"><span class="fa fa-calendar h4  mx-1 text-white"/></a>
        </xpath>                                                
    </template>
 
</odoo>
