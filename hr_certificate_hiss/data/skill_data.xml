<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ================================================================
         Elevator certifications.

         The auktorisation is held by the company, but the individual
         technician must be documented as competent under it. Modelling it
         as a skill is what makes the company's authorisation verifiable:
         it is only as good as the people it sends.
         ================================================================ -->

    <record id="skill_type_hiss" model="hr.skill.type">
        <field name="name">Hisscertifiering</field>
    </record>

    <record id="skill_level_certified" model="hr.skill.level">
        <field name="name">Certifierad</field>
        <field name="skill_type_id" ref="skill_type_hiss"/>
        <field name="level_progress">100</field>
        <field name="default_level" eval="True"/>
    </record>

    <!-- BFS 2011:12. The one that makes the work legal at all. -->
    <record id="skill_hissinstallation" model="hr.skill">
        <field name="name">Hissinstallation (auktorisation)</field>
        <field name="skill_type_id" ref="skill_type_hiss"/>
    </record>

    <!-- BFS 2011:12. Besiktning är ett eget kompetensområde: den som
         besiktigar får inte vara den som servar samma hiss. -->
    <record id="skill_hissbesiktning" model="hr.skill">
        <field name="name">Hissbesiktning</field>
        <field name="skill_type_id" ref="skill_type_hiss"/>
    </record>

    <!-- BFS 2011:12. Felsökning kräver mer än installation: man måste
         förstå hela anläggningen, inte bara monteringen. -->
    <record id="skill_hisservice" model="hr.skill">
        <field name="name">Hisservice — felsökning</field>
        <field name="skill_type_id" ref="skill_type_hiss"/>
    </record>

</odoo>
